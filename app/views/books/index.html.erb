<% content_for :title, "Books" %>

<div class="d-flex flex-row justify-content-between align-items-center">
  <h1>Books</h1>

  <%= form_with url: books_path, method: :get, local: true do |form| %>
    <div>
      <i class="fa-solid fa-magnifying-glass"></i>
      <%= form.text_field :search, value: params[:search], placeholder: "Search book by title..." %>
      <%= form.submit "Search" %>
    </div>
  <% end %>
</div>

<div>
  <%= link_to new_book_path do %>
    <i class="manage-icon fa-solid fa-circle-plus"></i>
  <% end %>
</div>

<table class="table table-sm table-striped ml-4 my-4">
  <thead>
    <tr>
      <th></th>
      <th>Title</th>
      <th>Description</th>
      <th>Genre</th>
      <th>User</th>
      <th>Cover</th>
    </tr>
  </thead>

  <tbody>
    <% @books.each do |book| %>
      <tr>
        <% if user_signed_in? %>
          <td>
            <% if book.liked?(current_user) %>
              <%= link_to book_like_path(book), data: { turbo_method: :delete } do %>
                <i class="fa-solid fa-heart book-liked liked" style="color: pink;"></i>
              <% end %>
            <% else %>
              <%= link_to book_like_path(book), data: { turbo_method: :post } do %>
                <i class="fa-regular fa-heart book-like"></i>
              <% end %>
            <% end %>
          </td>
        <% end %>
        <td><%= book.name %></td>
        <td><%= book.short_description %></td>
        <td><%= book.genres.map(&:name).join(", ") %></td>
        <td><%= book.user.first_name %></td>
        <td>
          <% if book&.cover&.attached? %>
            <%= image_tag url_for(book.cover), alt: "Book cover", class: "book-cover" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="pag-bar mt-3">
	<%== pagy_bootstrap_nav(@pagy) %>
</div>
