<% content_for :title, "Books" %>

<div class="d-flex flex-row justify-content-between align-items-center">
  <h1>Books</h1>

  <div class="align-items-end">
    <%= link_to new_book_path do %>
      <i class="manage-icon fa-solid fa-circle-plus"></i>
    <% end %>
  </div>
</div>


<table class="table table-sm table-striped ml-4 my-4">
  <thead>
    <tr>
      <th>Title</th>
      <th>Description</th>
      <th>Genre</th>
      <th>User</th>
      <th>Cover</th>
    </tr>
  </thead>

  <tbody>
    <% @books.each do |book| %>
      <tr>
        <td><%= book.name %></td>
        <td><%= book.short_description %></td>
        <td><%= book.genres.map(&:name).join(", ") %></td>
        <td><%= book.user.first_name %></td>
        <td>
          <% if book&.cover&.attached? %>
            <%= image_tag url_for(book.cover), alt: "Book cover", class: "book-cover" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="pag-bar mt-3">
	<%== pagy_bootstrap_nav(@pagy) %>
</div>