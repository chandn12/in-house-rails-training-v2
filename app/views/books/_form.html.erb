<%= form_with(model: @book, data: { turbo: false }, local: true, html: { multipart: true }) do |form| %>
  <% if @book.errors.any? %>
    <div style="color: red">
      <h5 class="fw-bold"><%= pluralize(@book.errors.count, "error") %> prohibited this book from being saved:</h5>

      <ul>
        <% @book.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="book-form">
    <div class="mb-3">
      <%= form.label :name, "Title", style: "display: block" %>
      <%= form.text_field :name, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :short_description, style: "display: block" %>
      <%= form.textarea :short_description, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :genre_ids, "Genre", style: "display: block" %>
      <%= form.collection_check_boxes :genre_ids, Genre.all, :id, :name do |b| %>
        <div class="form-checkbox mb-1">
          <%= b.check_box(class: "form-check-input") %>
          <%= b.label(class: "form-check-label ms-1") %>
        </div>
      <% end %>
    </div>

    <div class="mb-3">
      <%= form.file_field :cover, accept: "image/png,image/jpeg", class: "form-control" %>
    </div>

    <div class="text-end">
      <%= form.submit "Submit", class: "btn-submit" %>
    </div>
  </div>
<% end %>
