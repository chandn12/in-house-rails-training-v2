<div id="<%= dom_id book %>">
  <div>
    <strong>Name:</strong>
    <%= book.name %>
  </div>

  <div>
    <strong>Short description:</strong>
    <%= book.short_description %>
  </div>

  <div>
    <strong>User:</strong>
    <%= book.user_id %>
  </div>

  <div>
    <strong>Genre:</strong>
    <%= book.genre_id %>
  </div>

</div>
