<div id="<%= dom_id book %>">

  <div>
    <% if @book.cover.attached? %>
      <%= image_tag url_for(@book.cover), alt: "Book cover", class: "book-cover-lg mb-4" %>
    <% end %>
  </div>

  <div>
    <strong>Title:</strong>
    <%= book.name %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= book.short_description %>
  </div>

  <div>
    <strong>Genre:</strong>
    <%= book.genres.map(&:name).join(", ") %>
  </div>

  <div>
    <strong>User:</strong>
    <%= book.user.first_name %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= book.user.email %>
  </div>

  <div class="my-3">
    <strong>Created At:</strong> <%= @book.created_at&.strftime('%A %d %B %Y') %>
  </div>

</div>