<p style="color: green"><%= notice %></p>

<% content_for :title, "Users" %>

<div class="d-flex flex-row justify-content-between align-items-center">
  <h1>Users</h1>

  <div class="align-items-end">
    <%= link_to home_index_path do %>
      <i class="manage-icon me-2 fa-solid fa-house"></i>
    <% end %>
    <%= link_to new_user_path do %>
      <i class="manage-icon fa-solid fa-plus"></i>
    <% end %>
  </div>
</div>

<table class="table table-sm table-striped ml-4 my-4">
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>D.O.B</th>
    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.first_name %> <%= user.last_name %></td>
        <td><%= user.email %></td>
        <td><%= user.date_of_birth&.strftime('%d %B, %Y') %></td>
        <td>
          <div class="dropdown">
            <button class="btn-user-action dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              User Action
            </button>
            <ul class="dropdown-menu">
              <li>
                <%= link_to "View User", user_path(user), class: "dropdown-item" %>
              </li>
              <li>
                <%= link_to "Edit User", edit_user_path(user), class: "dropdown-item" %>
              </li>
              <li>
                <%= link_to "Destroy User", user_path(user), class: "dropdown-item text-danger", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
              </li>
            </ul>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="pag-bar mt-5 pt-5">
	<%== pagy_bootstrap_nav(@pagy) %>
</div>


