<% content_for :title, "Users" %>

<div class="d-flex flex-row justify-content-between align-items-center">
  <h1>Users</h1>

  <% if user_signed_in? && current_user.admin? %>
    <div class="align-items-end">
      <%= link_to new_admin_user_path do %>
        <i class="manage-icon fa-solid fa-circle-plus"></i>
      <% end %>
    </div>
  <% end %>
</div>

<table class="table table-sm table-striped ml-4 my-4">
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>D.O.B</th>
    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.first_name %> <%= user.last_name %></td>
        <td><%= user.email %></td>
        <td><%= user.date_of_birth&.strftime('%d %b, %Y') %></td>
        <td>
          <% if user_signed_in? && current_user.admin? %>
            <div class="dropend">
              <button class="btn-user-action dropdown-toggle rounded-pill" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="btn-text">User Action</span>
              </button>
              <ul class="dropdown-menu">
                <li>
                  <%= link_to "View User", admin_user_path(user), class: "dropdown-item" %>
                </li>
                <li>
                  <%= link_to "Edit User", edit_admin_user_path(user), class: "dropdown-item" %>
                </li>
                <li>
                  <%= link_to "Destroy User", admin_user_path(user), class: "dropdown-item text-danger", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
                </li>
              </ul>
            </div>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="pag-bar mt-3">
	<%== pagy_bootstrap_nav(@pagy) %>
</div>
