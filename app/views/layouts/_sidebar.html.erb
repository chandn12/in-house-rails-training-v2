<div class="sidebar d-flex flex-md-column justify-content-between">
  <div class="d-flex justify-content-center">
    <%= link_to home_index_path do %>
      <i class="sidebar-icon fa-solid fa-house"></i>
    <% end %>
  </div>

  <div class="d-flex flex-md-column align-items-center">
    <%= link_to users_path do %>
      <i class="sidebar-icon fa-solid fa-user"></i>
    <% end %>
    <%= link_to books_path, class: "px-4 px-md-0 py-md-4" do %>
      <i class="sidebar-icon fa-solid fa-book"></i>
    <% end %>
    <%= link_to genres_path do %>
      <i class="sidebar-icon fa-solid fa-g"></i>
    <% end %>
  </div>

  <div class="d-flex flex-md-column align-items-center">
    <% if user_signed_in? && current_user.admin? %>
      <%= link_to "/letter_opener", target: "_blank" do %>
        <i class="sidebar-icon fa-solid fa-envelopes-bulk me-4 me-md-0 mb-md-4"></i>
      <% end %>
    <% end %>
    <% if user_signed_in? %>
      <%= link_to destroy_user_session_path, data: { turbo_method: :delete } do %>
        <i class="sidebar-icon fa-solid fa-user-xmark"></i>
      <% end %>
    <% else %>
      <%= link_to new_user_registration_path do %>
        <i class="sidebar-icon fa-solid fa-user-plus"></i>
      <% end %>
    <% end %>
  </div>
</div>