<p style="color: green"><%= notice %></p>

<% content_for :title, "Genres" %>

<div class="d-flex flex-row justify-content-between align-items-center">
  <h1>Genres</h1>

  <%= link_to home_index_path do %>
    <i class="manage-icon me-2 fa-solid fa-house"></i>
  <% end %>
</div>

<table class="table table-sm table-striped ml-4 my-4">
  <thead>
    <tr>
      <th>Genre</th>
      <th>Book Title</th>
    </tr>
  </thead>

  <tbody>
    <% @genres.each do |genre| %>
      <tr>
        <td><%= genre.name %></td>
        <td><%= genre.books.map(&:name).join(", ") %></td>
        <td>
          <%= link_to genre do %>
            <i class="manage-icon-sm fa-solid fa-eye"></i>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="pag-bar mt-5 pt-5">
	<%== pagy_bootstrap_nav(@pagy) %>
</div>