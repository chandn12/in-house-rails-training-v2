<% content_for :title, "Genres" %>

<h1>Genres</h1>

<table class="table table-sm table-striped ml-4 my-4">
  <thead>
    <tr>
      <th>Genre</th>
      <th>Book Title</th>
    </tr>
  </thead>

  <tbody>
    <% @genres.each do |genre| %>
      <tr>
        <td><%= genre.name %></td>
        <td><%= genre.books.map(&:name).join(", ") %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="pag-bar mt-3">
	<%== pagy_bootstrap_nav(@pagy) %>
</div>