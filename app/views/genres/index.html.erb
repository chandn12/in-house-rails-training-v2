<% content_for :title, "Genres" %>

<div class="d-flex flex-row justify-content-between align-items-center">
  <h1>Genres</h1>
  <%= form_with url: genres_path, method: :get, local: true do |form| %>
    <div>
      <i class="fa-solid fa-magnifying-glass"></i>
      <%= form.text_field :search, value: params[:search], placeholder: "Search book by genre..." %>
      <%= form.submit "Search" %>
    </div>
  <% end %>
</div>

<table class="table table-sm table-striped ml-4 my-4">
  <thead>
    <tr>
      <th>Genre</th>
      <th>Book Title</th>
    </tr>
  </thead>

  <tbody>
    <% @genres.each do |genre| %>
      <tr>
        <td><%= genre.name %></td>
        <td><%= genre.books.map(&:name).join(", ") %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="pag-bar mt-3">
	<%== pagy_bootstrap_nav(@pagy) %>
</div>
