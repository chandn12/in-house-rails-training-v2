<div class="mt-2">
  <h1>Recent activities</h1>

  <table class="table table-sm table-striped ml-4 mt-3">
    <tbody>
      <% activities.each do |a| %>
        <% next unless a.trackable.present? %>
        <% next if a.trackable.is_a?(User) && !current_user.admin? %>
        <tr>
          <td><%= a.created_at %></td>
          <td>
            <% if a.trackable.is_a?(Book) %>
              <%= link_to a.trackable, a.trackable %>
            <% elsif a.trackable.is_a?(User) %>
              <%= link_to a.trackable, [:admin, a.trackable] %>
            <% end %>
          </td>
          <td>
            <%= a.owner&.first_name || "System" %>
          </td>
          <td class="d-flex flex-wrap justify-content-end">
            <% if a.trackable.is_a?(Book) %>
              <%= link_to book_path(a.trackable) do %>
                <i class="manage-icon fa-solid fa-eye"></i>
              <% end %>
              <% if can? :update, a.trackable %>
                <%= link_to edit_book_path(a.trackable) do %>
                  <i class="manage-icon fa-solid fa-pen-to-square ms-2"></i>
                <% end %>
              <% end %>
              <% if current_user.admin? && a.trackable.discarded? %>
                <%= link_to undiscard_book_path(a.trackable), data: { turbo_method: :patch } do %>
                  <i class="manage-icon manage-icon-undiscard fa-solid fa-rotate-left ms-2"></i>  
                <% end %>
              <% elsif can? :destroy, a.trackable %>  
                <%= link_to book_path(a.trackable), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } do %>
                  <i class="manage-icon manage-icon-destroy fa-solid fa-trash-can ms-2"></i>  
                <% end %>
              <% end %>
            <% end %>  
            <% if a.trackable.is_a?(Book) %>
              <% if can? :download_pdf, a.trackable %>
                <%= link_to book_path(a.trackable, format: :pdf), target: '_blank' do %>
                  <i class="manage-icon manage-icon-pdf fa-solid fa-file-pdf ms-2"></i>
                <% end %>  
              <% end %>
            <% elsif a.trackable.is_a?(User) %>
              <% if can? :download_xlsx, a.trackable %>
                <%= link_to admin_user_path(a.trackable, format: :xlsx), target: '_blank' do %>
                  <i class="manage-icon manage-icon-x fa-solid fa-file-excel ms-2"></i>
                <% end %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="pag-bar mt-3">
	<%== pagy_bootstrap_nav(@pagy) %>
</div>
